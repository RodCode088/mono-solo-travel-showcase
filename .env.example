# Mono Solo Travel - environment template
#
# Copy to `.env` only for local shell convenience. Do not commit `.env`.
# This file contains names only, never real credentials.

# ---------------------------------------------------------------------------
# Public browser runtime config
# ---------------------------------------------------------------------------
# Used by scripts/config/generate-runtime-config.js to create:
# src/config/runtime-config.local.js
#
# The key must be a public Supabase browser key compatible with supabase-js.
# In the current codebase the variable name remains SUPABASE_ANON_KEY for
# compatibility, even if the Supabase dashboard labels it as anon/public or
# publishable. Never put service_role or any secret key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
MS_MODE=mock

# ---------------------------------------------------------------------------
# Local dev server
# ---------------------------------------------------------------------------
# Used by scripts/dev/serve.js.
HOST=127.0.0.1
PORT=5173

# ---------------------------------------------------------------------------
# Staging E2E
# ---------------------------------------------------------------------------
# Used only by scripts/qa/e2e/booking-flow.e2e.js.
# E2E_ADMIN_PASSWORD is a local secret for the staging admin user. Keep it out
# of Git and do not paste it into frontend runtime files.
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
