# === Mono Solo Travel — .gitignore ===
# Objetivo: mantener el repositorio aislado, sin secretos ni artefactos locales.

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example
*.local
secrets/
credentials/
*.pem
*.key

# --- Dependencias ---
node_modules/
.qa_node/node_modules/
.codex_deps/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Carpetas temporales / build ---
tmp/
temp/
.cache/
dist/
dist-react/
build/
.parcel-cache/

# --- Resultados de pruebas / QA temporal ---
test-results/
playwright-report/
coverage/
.nyc_output/
qa-temp/
*-temp.png
screenshots-temp/

# --- Archivos de sistema operativo ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Archivos de editores / IDE ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# --- Configuración local del asistente (específica de la máquina) ---
.claude/settings.local.json
.claude/launch.json

# --- Configuración de runtime local (contiene anon key del entorno) ---
src/config/runtime-config.local.js

# --- Supabase local (cuando aplique en fases posteriores) ---
.supabase/
supabase/.temp/
supabase/.branches/

# --- Material entregado por el cliente, sin optimizar (924 MB) ---
# Las fotos que se usan en el sitio ya viven optimizadas en
# assets/mono_experience_by_cuanto_optimized/. Esta carpeta es el volcado
# original y no debe entrar al repositorio.
fotos para actualizar/

# --- Artefactos generados de los QR de hostels ---
# Se regeneran con el script de qrcode; el .zip es solo para enviar.
qr-hostels-mono-solo.zip
